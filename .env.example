# Copy to .env (git-ignored). agentlab and the live tests read it automatically;
# variables set in your shell take precedence.
# Never commit real keys. Setup guide: docs/development.md#api-key-only-needed-for-claude

# Required only for non-offline runs (agentlab ask/eval/flywheel without --offline).
ANTHROPIC_API_KEY=

# Optional overrides.
# AGENTLAB_MODEL=claude-opus-5-5
# AGENTLAB_TOOLS_DIR=tools
# AGENTLAB_CASES_DIR=evals/cases
# AGENTLAB_RUNS_DIR=runs
